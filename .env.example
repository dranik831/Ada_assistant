# Telegram API credentials
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Telegram MTProto proxy
TG_PROXY_ENABLED=false
TG_PROXY_TYPE=mtproxy
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=1080
TG_PROXY_SECRET=

# Administrator
ADMIN_USERNAME=
ADMIN_USER_ID=0

# Separate Telegram control bot (control_bot.py). Use only trusted numeric IDs.
CONTROL_BOT_TOKEN=
CONTROL_BOT_ALLOWED_IDS=
# Public HTTPS origin forwarding to the local Mini App port. Empty disables it.
CONTROL_WEB_URL=
CONTROL_WEB_PORT=8765
CONTROL_WEB_BIND=127.0.0.1
CONTROL_WEB_PROXY_PEER=
ADA_LOG_LEVEL=INFO

# LLM provider chain, in priority order (comma-separated). The first provider
# that works is used; on any error Ada falls back to the next one in the list.
# Available: openai_compatible, gemini, anthropic.
LLM_PROVIDERS=openai_compatible,gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Anthropic (Claude): official API, or any Anthropic-compatible gateway.
# No trailing /v1 — the SDK appends /v1/messages to this address itself.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

LLM_TIMEOUT_SECONDS=45
LLM_STARTUP_TIMEOUT_SECONDS=12

# Modules from the modules/ folder. The folder name is the flag name:
# MODULE_<NAME>=false disables the module completely and skips its imports,
# so its dependencies are not required while it is off.
# Status: edit mode -> "модули". Details: modules/README.md
MODULE_VOICE=true
MODULE_VISION=true
MODULE_PC_CONTROL=true
MODULE_TELEGRAM_TOOLS=true
MODULE_SCHEDULE_COLLEGE=true
MODULE_SECRETARY=true
MODULE_EMAIL=false
MODULE_MINECRAFT=false

# Voice module (modules/voice): Ctrl+Alt+Space in the local PC menu
VOICE_ENABLED=true

# Minecraft module (modules/minecraft): RCON commands + chat read from logs/latest.log.
# MINECRAFT_SERVER_DIR is the server root; logs/latest.log is found inside it.
# Use MINECRAFT_LOG_PATH instead for a direct path to the log file.
MINECRAFT_RCON_HOST=127.0.0.1
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=
MINECRAFT_SERVER_DIR=
MINECRAFT_LOG_PATH=
MINECRAFT_CHAT_REPLY_PROBABILITY=0.3
MINECRAFT_CHAT_COOLDOWN_SECONDS=20

# Vision module (modules/vision): empty VISION_BASE_URL (default) means "use the
# main LLM provider" (ACTIVE_LLM_*) instead of a separate vision model. Fill these
# in to use a dedicated VLM instead, e.g. a local one via Ollama:
#   VISION_BASE_URL=http://localhost:11434/v1
#   VISION_MODEL=qwen3-vl:2b
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=120

# Speech recognition: local (Whisper medium on PC) or api (external server)
WHISPER_MODE=local
WHISPER_API_URL=
WHISPER_API_KEY=

# Autonomy and groups
AUTONOMY_ENABLED=true
GROUP_AUTONOMY_ENABLED=true
GROUP_REPLY_PROBABILITY=0.08
GROUP_REPLY_COOLDOWN_MINUTES=20
MESSAGE_DEBOUNCE_SECONDS=3
# Dialog context: last N chats (including current) x last M messages each.
# A background chat (not the current one) silent for CONTEXT_FORGET_MINUTES
# is dropped from context until it gets a new message.
CONTEXT_CHATS=3
CONTEXT_MESSAGES_PER_CHAT=10
CONTEXT_FORGET_MINUTES=20
QUIET_HOURS_START=23
QUIET_HOURS_END=8

# Secretary
SECRETARY_ENABLED=true
CALENDAR_FILE=data/calendar.json
SCHEDULE_FILE=data/schedule.json
MAINTENANCE_NAME=Ada | TECH WORKS
NORMAL_NAME=Ada

# College schedule portal (study.ukrtb.ru)
UKRTB_GROUP_ID=
UKRTB_GROUP_LABEL=

# Optional shell allowlist for execute_system_command (comma-separated, empty = any)
SYSTEM_COMMAND_ALLOWLIST=
