# Telegram API credentials
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Telegram MTProto proxy
TG_PROXY_ENABLED=false
TG_PROXY_TYPE=mtproxy
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=1080
TG_PROXY_SECRET=

# Administrator
ADMIN_USERNAME=
ADMIN_USER_ID=0

# LLM provider: gemini or openai_compatible
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI-compatible fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_STARTUP_TIMEOUT_SECONDS=12

# Modules from the modules/ folder. The folder name is the flag name:
# MODULE_<NAME>=false disables the module completely and skips its imports,
# so its dependencies are not required while it is off.
# Status: edit mode -> "модули". Details: modules/README.md
MODULE_VOICE=true
MODULE_VISION=true
MODULE_PC_CONTROL=true
MODULE_TELEGRAM_TOOLS=true
MODULE_SCHEDULE_COLLEGE=true
MODULE_SECRETARY=true
MODULE_EMAIL=false

# Voice module (modules/voice): Ctrl+Alt+Space in the local PC menu
VOICE_ENABLED=true

# Vision module (modules/vision): empty VISION_BASE_URL (default) means "use the
# main LLM provider" (ACTIVE_LLM_*) instead of a separate vision model. Fill these
# in to use a dedicated VLM instead, e.g. a local one via Ollama:
#   VISION_BASE_URL=http://localhost:11434/v1
#   VISION_MODEL=qwen3-vl:2b
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=120

# Speech recognition: local (Whisper medium on PC) or api (external server)
WHISPER_MODE=local
WHISPER_API_URL=
WHISPER_API_KEY=

# Autonomy and groups
AUTONOMY_ENABLED=true
GROUP_AUTONOMY_ENABLED=true
GROUP_REPLY_PROBABILITY=0.08
GROUP_REPLY_COOLDOWN_MINUTES=20
MESSAGE_DEBOUNCE_SECONDS=3
# Dialog context: last N chats (including current) x last M messages each.
# A background chat (not the current one) silent for CONTEXT_FORGET_MINUTES
# is dropped from context until it gets a new message.
CONTEXT_CHATS=3
CONTEXT_MESSAGES_PER_CHAT=10
CONTEXT_FORGET_MINUTES=20
QUIET_HOURS_START=23
QUIET_HOURS_END=8

# Secretary
SECRETARY_ENABLED=true
CALENDAR_FILE=data/calendar.json
SCHEDULE_FILE=data/schedule.json
MAINTENANCE_NAME=Ada | TECH WORKS
NORMAL_NAME=Ada

# College schedule portal (study.ukrtb.ru)
UKRTB_GROUP_ID=
UKRTB_GROUP_LABEL=

# Optional shell allowlist for execute_system_command (comma-separated, empty = any)
SYSTEM_COMMAND_ALLOWLIST=
