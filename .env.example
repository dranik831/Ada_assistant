# Telegram API credentials (получать на https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Telegram MTProto proxy
TG_PROXY_ENABLED=true
TG_PROXY_TYPE=mtproxy
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=1080
TG_PROXY_SECRET=

# Администратор (Username без @ и числовой ID если известен)
ADMIN_USERNAME=
ADMIN_USER_ID=

LLM_PROVIDER=           #openai_compatible or gemini

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

# Запасной OpenAI-compatible провайдер
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Настройки автономности
AUTONOMY_ENABLED=true
GROUP_AUTONOMY_ENABLED=true
GROUP_REPLY_PROBABILITY=0.9
GROUP_REPLY_COOLDOWN_MINUTES=0
MESSAGE_DEBOUNCE_SECONDS=3
QUIET_HOURS_START=00
QUIET_HOURS_END=6
