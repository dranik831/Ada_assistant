# Telegram API credentials
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Telegram MTProto proxy
TG_PROXY_ENABLED=false
TG_PROXY_TYPE=mtproxy
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=1080
TG_PROXY_SECRET=

# Administrator
ADMIN_USERNAME=
ADMIN_USER_ID=0

# LLM provider: gemini or openai_compatible
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI-compatible fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_STARTUP_TIMEOUT_SECONDS=12

# Autonomy and groups
AUTONOMY_ENABLED=true
GROUP_AUTONOMY_ENABLED=true
GROUP_REPLY_PROBABILITY=0.08
GROUP_REPLY_COOLDOWN_MINUTES=20
MESSAGE_DEBOUNCE_SECONDS=3
QUIET_HOURS_START=23
QUIET_HOURS_END=8

# Secretary
SECRETARY_ENABLED=true
CALENDAR_FILE=data/calendar.json
SCHEDULE_FILE=data/schedule.json
MAINTENANCE_NAME=Ada | TECH WORKS
NORMAL_NAME=Ada

# College schedule portal (study.ukrtb.ru)
UKRTB_GROUP_ID=
UKRTB_GROUP_LABEL=
